{
  "name": "pelote-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --write tests/canAdministerClubGuard.test.mjs tests/platformAdminLeaseGuard.test.mjs && git diff -- tests/canAdministerClubGuard.test.mjs tests/platformAdminLeaseGuard.test.mjs && prettier --check .",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "security:secrets": "node scripts/security/check-secrets.mjs",
    "platform:validate-installation-bundle": "node supabase/platform/installation/validatePlatformInstallationBundle.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.71.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "read-excel-file": "^9.3.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.7",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
