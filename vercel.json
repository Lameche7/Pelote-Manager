{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/Morlaas",
      "has": [
        {
          "type": "host",
          "value": "app.pelotemanager.fr"
        }
      ],
      "destination": "/?club=pelotari-club-morlaas",
      "permanent": false
    },
    {
      "source": "/morlaas",
      "has": [
        {
          "type": "host",
          "value": "app.pelotemanager.fr"
        }
      ],
      "destination": "/?club=pelotari-club-morlaas",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pelotemanager.fr"
        }
      ],
      "destination": "https://www.pelotemanager.fr/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/live-google-configuration",
      "destination": "/api/live-google-connect"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/live-youtube-prepare",
      "schedule": "0 5 * * *"
    }
  ]
}
